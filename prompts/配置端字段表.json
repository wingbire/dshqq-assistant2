{
  "版本": 1,
  "说明": "配置端字段表：前端按此渲染，加配置项只改本表 + src/kernel.js 的清单命令",
  "分组": [
    {
      "名": "人设",
      "键前缀": "persona",
      "字段": [
        {
          "键": "persona.botName",
          "标签": "小助手名",
          "类型": "string",
          "默认": "小肥鱼",
          "回写": true
        },
        {
          "键": "persona.age",
          "标签": "身份/年龄段",
          "类型": "string",
          "默认": "二十来岁"
        },
        {
          "键": "persona.traits",
          "标签": "性格关键词",
          "类型": "string[]",
          "默认": [
            "嘴贫但有分寸",
            "对熟的人话多",
            "被问到就认真"
          ],
          "最大": 3
        },
        {
          "键": "persona.interests",
          "标签": "感兴趣的话题",
          "类型": "string[]",
          "默认": []
        },
        {
          "键": "persona.dislikes",
          "标签": "不想碰的话题",
          "类型": "string[]",
          "默认": []
        },
        {
          "键": "persona.tone",
          "标签": "全局语气",
          "类型": "enum",
          "取值": [
            "精炼",
            "详细"
          ],
          "默认": "精炼"
        },
        {
          "键": "persona.overflow",
          "标签": "超字数处理",
          "类型": "enum",
          "取值": [
            "压缩成一条",
            "拆两条"
          ],
          "默认": "压缩成一条"
        },
        {
          "键": "persona.memeFreq",
          "标签": "表情包频率",
          "类型": "enum",
          "取值": [
            "关",
            "少",
            "中"
          ],
          "默认": "少"
        }
      ]
    },
    {
      "名": "判定",
      "键前缀": "gates",
      "字段": [
        {
          "键": "gates.depthChars",
          "标签": "三档字数上限",
          "类型": "int[3]",
          "默认": [
            20,
            60,
            200
          ]
        },
        {
          "键": "gates.utilitySpeakAt",
          "标签": "开口阈值",
          "类型": "number",
          "默认": 0.2,
          "范围": [
            0.05,
            0.55
          ]
        },
        {
          "键": "gates.utilityTerseAt",
          "标签": "常规线",
          "类型": "number",
          "默认": 0.35,
          "范围": [
            0.1,
            0.75
          ]
        },
        {
          "键": "gates.utilityDetailedAt",
          "标签": "多讲线",
          "类型": "number",
          "默认": 0.65,
          "范围": [
            0.2,
            0.95
          ]
        },
        {
          "键": "gates.utilityLambda",
          "标签": "成本权重 λ",
          "类型": "number",
          "默认": 0.5,
          "范围": [
            0,
            2
          ]
        },
        {
          "键": "gates.greyLo",
          "标签": "灰区下界",
          "类型": "number",
          "默认": 0.4,
          "自适应": true
        },
        {
          "键": "gates.greyHi",
          "标签": "灰区上界",
          "类型": "number",
          "默认": 0.75,
          "自适应": true
        },
        {
          "键": "gates.weights",
          "标签": "六因子权重 w1..w4",
          "类型": "number[4]",
          "默认": [
            0.4,
            0.2,
            0.25,
            0.15
          ]
        }
      ]
    },
    {
      "名": "主动与节流",
      "键前缀": "autojoin",
      "字段": [
        {
          "键": "autojoin.rate",
          "标签": "主动参与意愿",
          "类型": "number",
          "默认": 0.25,
          "范围": [
            0.15,
            0.6
          ]
        },
        {
          "键": "autojoin.minGapSec",
          "标签": "最小间隔(秒)",
          "类型": "int",
          "默认": 120,
          "范围": [
            5,
            600
          ]
        }
      ]
    },
    {
      "名": "运行时",
      "键前缀": "runtime",
      "字段": [
        {
          "键": "runtime.stageMode",
          "标签": "开口阶段",
          "类型": "enum",
          "取值": ["auto", "observe", "live"],
          "默认": "auto",
          "说明": "auto=新群先观察→半自动→全自动（N9）"
        },
        {
          "键": "runtime.observeUntilMessages",
          "标签": "新群观察条数",
          "类型": "int",
          "默认": 80,
          "范围": [20, 500],
          "说明": "N9：攒满这么多条就转半自动"
        },
        {
          "键": "runtime.semiAutoDays",
          "标签": "半自动天数",
          "类型": "int",
          "默认": 3,
          "范围": [0, 30],
          "说明": "N9：半自动跑满这么多天转全自动"
        },
        {
          "键": "runtime.contextWindow",
          "标签": "上下文窗口(条)",
          "类型": "int",
          "默认": 10,
          "范围": [0, 30],
          "说明": "N8：进 prompt 且排在最后的群消息条数"
        },
        {
          "键": "runtime.coalesceWindowMs",
          "标签": "连发合并窗口(毫秒)",
          "类型": "int",
          "默认": 6000,
          "范围": [1000, 20000],
          "说明": "N23：同一人连发多久算一轮"
        },
        {
          "键": "runtime.maxSegments",
          "标签": "最多分几条",
          "类型": "int",
          "默认": 3,
          "范围": [1, 6],
          "说明": "N6：超长回复最多拆成几条"
        },
        {
          "键": "runtime.search.mode",
          "标签": "搜索通道",
          "类型": "enum",
          "取值": ["c", "b"],
          "默认": "c",
          "说明": "N12：c=本机直搜（零模型调用），b=DSH 独立调用"
        },
        {
          "键": "runtime.budget.dailyTokens",
          "标签": "日预算(token)",
          "类型": "int",
          "默认": 5000000,
          "说明": "N23：超 80% 关主动，超 100% 只回被点名的"
        },
        {
          "键": "runtime.budget.groupHourlyLimit",
          "标签": "每群每小时上限(0=不限)",
          "类型": "int",
          "默认": 0,
          "说明": "N23：已取消，保持 0"
        },
        {
          "键": "admin.whitelist",
          "标签": "管理员白名单",
          "类型": "string[]",
          "默认": [],
          "说明": "N10：白名单里的 QQ 号可以发 /停 /开 /状态"
        }
      ]
    },
    {
      "名": "接入",
      "键前缀": "napcat",
      "字段": [
        {
          "键": "napcat.wsUrl",
          "标签": "OneBot WS 地址",
          "类型": "string",
          "默认": "ws://127.0.0.1:3001"
        },
        {
          "键": "napcat.token",
          "标签": "访问令牌",
          "类型": "secret",
          "默认": ""
        },
        {
          "键": "brain.dshCliPath",
          "标签": "大脑(DSH CLI)路径",
          "类型": "string",
          "默认": ""
        },
        {
          "键": "llm.search.apiKey",
          "标签": "搜索 API Key",
          "类型": "secret",
          "默认": ""
        }
      ]
    }
  ]
}